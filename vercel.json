{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/process-scheduled-tasks",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/process-account-blocks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reject-transfers",
      "schedule": "0 2 * * *"
    }
  ]
}
